            "cd8a26add53246649dbcbb73ac2c70d9",
            "4ffd060321964fa49a685bee7ef6651e",
            "2b86f1eac08246e8b3734305d14f0da0",
            "607a1563fb5346deb0053db65691525c",
            "7e7fa7e9cf05490f830cc828c326fa5b",
            "c63efd97cec84e45912c3c4fd9e8b361",
            "3655a6f6440e42f6af2cd8c6e05aaefa",
            "95b54398326447c3b8ba9f7c72d06546"
          ]
        },
        "id": "xew1xOw82cFL",
        "outputId": "9b7bf3f0-5a92-4f03-ca7c-d54b7d4971ac"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "Loading weights:   0%|          | 0/201 [00:00<?, ?it/s]"
            ],
            "application/vnd.jupyter.widget-view+json": {
              "version_major": 2,
              "version_minor": 0,
              "model_id": "1956f567e6014792a8513dfcdb0c04f4"
            }
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def predict_bert(texts):\n",
        "    preds = []\n",
        "\n",
        "    for i in range(0, len(texts), BATCH_SIZE):\n",
        "\n",
        "        batch_texts = texts[i:i + BATCH_SIZE]\n",
        "\n",
        "        inputs = bert_tokenizer(\n",
        "            batch_texts,\n",
        "            padding=True,\n",
        "            truncation=True,\n",
        "            max_length=MAX_LEN,\n",
        "            return_tensors=\"pt\"\n",
        "        )\n",
        "\n",
        "        inputs = {k: v.to(DEVICE) for k, v in inputs.items()}\n",
        "\n",
        "        with torch.no_grad():\n",
        "            outputs = bert_model(**inputs)\n",
        "\n",
        "        batch_preds = torch.argmax(outputs.logits, dim=1)\n",
        "\n",
        "        preds.extend(batch_preds.cpu().numpy())\n",
        "\n",
        "    return preds\n",
        "\n",
        "y_pred_bert = predict_bert(df_test['text_bert'].tolist())"
      ],
      "metadata": {
        "id": "wD9UsinAzcMn"
      },
      "execution_count": 8,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Sanity Check\n",
        "print(\"Accuracy SVM :\", accuracy_score(y_true, y_pred_svm))\n",
        "print(\"Accuracy BERT:\", accuracy_score(y_true, y_pred_bert))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "omZNe-DVVDQx",
        "outputId": "6efaa8d6-9b17-4895-c5b2-99a3216f158f"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Accuracy SVM : 0.7780040733197556\n",
            "Accuracy BERT: 0.7556008146639511\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "svm_correct = (y_pred_svm == y_true)\n",
        "bert_correct = (np.array(y_pred_bert) == y_true)\n",
        "\n",
        "a = np.sum(svm_correct & bert_correct)\n",
        "b = np.sum(svm_correct & ~bert_correct)\n",
        "c = np.sum(~svm_correct & bert_correct)\n",
        "d = np.sum(~svm_correct & ~bert_correct)\n",
        "\n",
        "print(f\"a (keduanya benar)        : {a}\")\n",
        "print(f\"b (SVM benar, BERT salah) : {b}\")\n",
        "print(f\"c (SVM salah, BERT benar) : {c}\")\n",
        "print(f\"d (keduanya salah)        : {d}\")\n",
        "print(f\"Discordant Pairs (b+c)    : {b + c}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "a9XtK832ze-V",
        "outputId": "32fcd4ee-3647-4f40-df14-5ac357ed0095"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "a (keduanya benar)        : 338\n",
            "b (SVM benar, BERT salah) : 44\n",
            "c (SVM salah, BERT benar) : 33\n",
            "d (keduanya salah)        : 76\n",
            "Discordant Pairs (b+c)    : 77\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "table = [[a, b], [c, d]]\n",
        "\n",
        "result = mcnemar(table, exact=False, correction=True)\n",
        "\n",
        "print(f\"\\nStatistik McNemar : {result.statistic:.4f}\")\n",
        "print(f\"p-value           : {result.pvalue:.4f}\")\n",
        "\n",
        "if result.pvalue < 0.05:\n",
        "    print(\"→ Perbedaan SIGNIFIKAN secara statistik (p < 0.05)\")\n",
        "else:\n",
        "    print(\"→ Perbedaan TIDAK signifikan secara statistik (p ≥ 0.05)\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
