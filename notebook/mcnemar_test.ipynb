            "\n",
            "Statistik McNemar : 1.2987\n",
            "p-value           : 0.2545\n",
            "→ Perbedaan TIDAK signifikan secara statistik (p ≥ 0.05)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Konversi ke label teks\n",
        "y_true_label = [inverse_label_map[i] for i in y_true]\n",
        "y_pred_svm_label = [inverse_label_map[i] for i in y_pred_svm]\n",
        "y_pred_bert_label = [inverse_label_map[i] for i in y_pred_bert]"
      ],
      "metadata": {
        "id": "WyqLWmOizs-p"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "results = pd.DataFrame({\n",
