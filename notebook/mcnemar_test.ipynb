      "source": [
        "import pickle\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "from transformers import AutoModelForSequenceClassification, AutoTokenizer\n",
        "from statsmodels.stats.contingency_tables import mcnemar\n",
        "from sklearn.metrics import accuracy_score"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Menghubungkan Drive ke Colab\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jpvcniw40Jyz",
        "outputId": "1ceffc6e-41fc-4a44-efa9-5541dcf07108"
      },
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Mounted at /content/drive\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "path = '/content/drive/MyDrive/skripsi/svm_indobert/data/final_data/2026_krl_complaints_preprocessed_4.csv'\n",
        "df_test = pd.read_csv(path)"
      ],
      "metadata": {
        "id": "hlQujhKGzXlI"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "label_map = {\n",
        "    'Keterlambatan': 0,\n",
        "    'Pelayanan': 1,\n",
        "    'Kepadatan': 2,\n",
        "    'Keamanan': 3,\n",
        "    'Kebersihan': 4\n",
        "}\n",
        "\n",
        "inverse_label_map = {v: k for k, v in label_map.items()}\n",
        "\n",
        "# Ground truth numerik\n",
        "y_true = df_test['label'].map(label_map).values"
      ],
      "metadata": {
        "id": "0fIbDgLlRvqe"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "BUNDLE_PATH = '/content/drive/MyDrive/skripsi/svm_indobert/model/svm_linearsvc_data_2_2.pkl'\n",
        "with open(BUNDLE_PATH, 'rb') as f:\n",
        "    bundle = pickle.load(f)\n",
        "\n",
        "svm_model = bundle['model']\n",
        "vectorizer   = bundle['vectorizer']"
      ],
      "metadata": {
        "id": "aNNu4952zanb"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "X_test_processed = df_test['text_svm']\n",
        "X_test_tfidf = vectorizer.transform(X_test_processed)\n",
        "y_pred_svm = svm_model.predict(X_test_tfidf)"
      ],
      "metadata": {
        "id": "vU6M6lsQ0q1b"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Config\n",
        "SAVE_DIR   = '/content/drive/MyDrive/skripsi/svm_indobert/model/indobert_data_2_2'\n",
        "DEVICE     = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "MAX_LEN    = 128\n",
        "BATCH_SIZE = 16\n",
        "\n",
        "# Load  Model & Tokenizer\n",
        "bert_model = AutoModelForSequenceClassification.from_pretrained(SAVE_DIR)\n",
        "bert_model.to(DEVICE)\n",
        "bert_model.eval()\n",
        "bert_tokenizer = AutoTokenizer.from_pretrained(SAVE_DIR)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 49,
          "referenced_widgets": [
            "1956f567e6014792a8513dfcdb0c04f4",
